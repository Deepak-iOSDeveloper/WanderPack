# ============================================
# WanderPack Environment Variables
# ============================================

# Frontend - Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_ENABLE_BACKEND=false
# Optional when using a separate backend server:
# VITE_API_BASE_URL=http://127.0.0.1:5000

# Backend - Server Configuration
NODE_ENV=development
PORT=5000

# Backend - Database Configuration
MONGODB_URI=mongodb://localhost:27017/wanderpack
# For MongoDB Atlas: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wanderpack

# Backend - CORS Configuration
CLIENT_URL=http://127.0.0.1:5173
